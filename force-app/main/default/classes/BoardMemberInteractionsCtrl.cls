public without sharing class BoardMemberInteractionsCtrl {

    private final static Map<String, SObjectField> INTERACTION_FIELD_MAP = Interaction__c.sObjectType.getDescribe().fields.getMap();
    private final static List<String> PERM_DESC_PRIORITY_LIST = Label.BoardMemberInteractionsDescFields.split(',');
    
    private static final String ERR_CONSTRUCTOR = 'BOARD_MEMBER_INTERACTIONS_CTRL_CONSTRUCTOR_FAILED';
    
    private Environment_Setting__mdt variables = Environment.getEnvironmentSetting();
    public List<InteractionWrap> interactions {get; set;}
    public String currentDateLocal {get; set;}
    public String title {get; set;}
    public static Boolean isAutoGenerated {get; set;}
    public static Boolean hasInteractions {get; set;}
    public String trcolor = '#D9E1F2';
    public List<String> excludedContactNames = new List<String>{'Michael R. Bloomberg','Patricia E. Harris'};
    
    public BoardMemberInteractionsCtrl() {
        try {
            String param = ApexPages.currentPage().getParameters().get('last');
            String comPram = ApexPages.currentPage().getParameters().get('committee');
            String fromDate = ApexPages.currentPage().getParameters().get('from');
            String toDate = ApexPages.currentPage().getParameters().get('to');
            if(ApexPages.currentPage().getParameters().get('isAutoGenerated') != null)
                isAutoGenerated = Boolean.valueOf(ApexPages.currentPage().getParameters().get('isAutoGenerated'));
            currentDateLocal =  System.now().format();
            interactions = new List<InteractionWrap>();
            String orgEngagedId = Schema.SObjectType.Interaction__c.getRecordTypeInfosByDeveloperName().get('Recent_Engagement').getRecordTypeId();
            Date lastBoardMeeting = variables.LastBoardMeeting__c;
            String suffix = '';
            Map<String, String> titleByParam = getTitleByParam(); //Get tile and param pairing from metadata type
            String query = 'SELECT Full_Name__c, Preferred_FirstName_LastName__c, BP_Board_Member_Former_Board_Member__c, ' + 
                                  '(SELECT ' + getDescQueryFields() + ' Interaction_Date__c, Name ' + 
                                  ' FROM Political_Interactions__r ' + 
                                  ' WHERE ';
            Boolean lastBoardMeetingFlag = false;
            Boolean periodSelection = false;
            if('y'.equals(param)) {
                lastBoardMeetingFlag = true;
                title = 'Board Member Interactions - Since ' + 
                        DateTime.newInstance(lastBoardMeeting.year(), lastBoardMeeting.month(), lastBoardMeeting.day()).format('MMMM') + 
                        ' ' + lastBoardMeeting.day() + ' ' + lastBoardMeeting.year()+' (last board meeting)'; 
                query += ' Interaction_Date__c >= :lastBoardMeeting';
            } else if(String.isNotBlank(comPram)) {
                query += ' Interaction_Date__c = THIS_YEAR ';
            } else if(String.isNotBlank(fromDate) && String.isNotBlank(toDate)) {
                periodSelection = true;
                Date fromDateFlag = Date.newInstance(Integer.valueOf(fromDate.substring(0, 4)), 
                                                     Integer.valueOf(fromDate.substring(4, 6)), 
                                                     Integer.valueOf(fromDate.substring(6, 8)));
                Date toDateFlag = Date.newInstance(Integer.valueOf(toDate.substring(0, 4)), 
                                                   Integer.valueOf(toDate.substring(4, 6)), 
                                                   Integer.valueOf(toDate.substring(6, 8)));
                query += ' Interaction_Date__c >= :fromDateFlag AND Interaction_Date__c <= :toDateFlag ';
            } else {
                title = 'BRM Monthly Report: Board Member Interactions - ' + getLastMonthName() + ' ' + getLastMonthYear();
                query += ' Interaction_Date__c = LAST_MONTH ';
            }
            query += ' AND RecordTypeId <> :orgEngagedId ORDER BY Interaction_Date__c DESC) ';
            if(String.isNotBlank(comPram)) { //Add history checking for the title
                title = 'Board Member Interactions - ' + titleByParam.get(comPram) +' (Since ' + getDateOfFirstMonth() + ')';
                query += ', (SELECT Role__c, Title__c, To__c FROM Employment_History__r WHERE Title__c = \'' + titleByParam.get(comPram) + '\')';
            } 
            query += ' FROM Contact WHERE BP_Board_Member_Former_Board_Member__c = \'Board Member\' AND Restricted__c = FALSE';
            query += ' AND Name NOT IN :excludedContactNames';
            query += ' ORDER BY LastName ASC';
            
            for(Contact cnt : (List<Contact>)Database.query(query)) {
                if(String.isNotBlank(comPram) && 
                   (cnt.Employment_History__r.size() == 0 || 
                    (String.isNotBlank(cnt.Employment_History__r[0].To__c) && 
                     cnt.Employment_History__r[0].To__c < String.valueOf(Date.today().year())))) {

                    continue;
                } 
                InteractionWrap tmpWrap = new InteractionWrap();
                tmpWrap.rowCount = 0;
                tmpWrap.boardMember = cnt.Preferred_FirstName_LastName__c;
                List<InteractionInfo> infos = new List<InteractionInfo>();
                List<String> descFieldsList = getDescriptionFieldsList();
                if(cnt.Political_Interactions__r != null && cnt.Political_Interactions__r.size() > 0) {
                    for(Interaction__c interaction : cnt.Political_Interactions__r) {
                        hasInteractions = true;
                        InteractionInfo info = new InteractionInfo();
                        info.interactionDate = interaction.Interaction_Date__c != null ? interaction.Interaction_Date__c.format() : '';
                        info.description = getDescription(interaction, descFieldsList);
                        infos.add(info);
                    }
                }
                if(infos.size() == 0) {
                    InteractionInfo info = new InteractionInfo();
                    info.interactionDate = periodSelection == true?'':lastBoardMeetingFlag == false? getLastMonthName():lastBoardMeeting.format();
                    info.description = 'No Interactions';
                    infos.add(info);
                }
                tmpWrap.info = infos;
                tmpWrap.rowCount = infos.size();
                interactions.add(tmpWrap);
            }
        } catch (Exception ex) {
            BBApps_ErrorCustomFields f = new BBApps_ErrorCustomFields(ERR_CONSTRUCTOR);
            BBApps_ErrorHandler.logErrors(ex, f);
        }
    }
    
    @TestVisible
    private String getDescQueryFields() {
        String fields = '';        
        for(String field : PERM_DESC_PRIORITY_LIST) {
            if(INTERACTION_FIELD_MAP.get(field) != null && INTERACTION_FIELD_MAP.get(field).getDescribe().isAccessible()) {
                fields += field+',';
            }
        }
        return fields;
    }
    
    @TestVisible
    private String getDescription(SObject interaction, List<String> descFieldsList) {
        for(String field : descFieldsList) {
            String myDesc = interaction.get(field) != null ? interaction.get(field) + '' : '';
            if(!String.isBlank(myDesc)) {
                return getFormattedDesc(myDesc);
            }
        }
        return interaction.get('Name') != null ? interaction.get('Name') + '' : '';
    }
    
    private String getFormattedDesc(String s) {
        if(String.isBlank(s)) return '';
        List<String> parts = s.split(' ');
        String formatted = '';
        Integer max = 35;
        for(String p : parts) {
            if(p.length() >= max) {
                formatted += '<br/>';
            }
            while(p.length() >= max) {
                formatted += p.substring(0, max)+'<br/>';
                p = p.substring(max);
            }
            if(!String.isBlank(p)) {
                formatted += p+' ';
            }
        }
        return formatted;
    }
    
    @TestVisible
    private List<String> getDescriptionFieldsList() {
        List<String> descFieldSet = new List<String>();
        for(String key : PERM_DESC_PRIORITY_LIST) {
            if(INTERACTION_FIELD_MAP.get(key) != null && INTERACTION_FIELD_MAP.get(key).getDescribe().isAccessible()) {
                descFieldSet.add(key);
            }
        }
        return descFieldSet;
    }
    
    private Map<String, String> getTitleByParam() {
        Map<String, String> tmp = new Map<String, String>();
        for(BoardMemberParam__mdt bmp : [SELECT ParamName__c, Title__c FROM BoardMemberParam__mdt]) {
            tmp.put(bmp.ParamName__c, bmp.Title__c);
        }
        return tmp;
    }
    
    private String getDateOfFirstMonth() {
        Datetime firstMonth = Datetime.newInstance(Date.today().year(), 1, 1);
        return firstMonth.format('MMMM') + ' ' + firstMonth.year();
    }

    private String getLastMonthYear() {
        Datetime dt = Datetime.now().addMonths(-1);
        return String.valueOf(dt.year());
    }
    
    private String getLastMonthName() {
        DateTime dt = Datetime.now().addMonths(-1);
        return dt.format('MMMM');
    }
    
    public class InteractionWrap {
        public String boardMember {get; set;}
        public List<InteractionInfo> info {get; set;}
        public Integer rowCount {get; set;}
    }
    
    public class InteractionInfo {
        public String interactionDate {get; set;}
        public String description {get; set;}
    }
}