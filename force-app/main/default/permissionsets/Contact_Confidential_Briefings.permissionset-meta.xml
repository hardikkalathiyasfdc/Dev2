<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <customPermissions>
        <enabled>true</enabled>
        <name>Confidential_Files_Access</name>
    </customPermissions>
    <description>Confidential. Not part of any profile, each user who has access has to have this permission set applied plus corresponding Public Group.  Pertains to the Confidential Briefings component on the Contact layout page and lists layout.</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>Confidential_Items__c.Campaign__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Confidential_Items__c.Contact__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Contacts &amp; Lists: Confidential Briefings</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Confidential_Items__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>
