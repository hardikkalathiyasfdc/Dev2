    <description>This flow Sends an email once &quot;Add to List&quot; is complete.</description>
    <environments>Default</environments>
    <formulas>
        <name>AllLoadedEmailSuject</name>
        <dataType>String</dataType>
        <expression>&apos;All Contacts Loaded to list: &apos;+{!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>CountOfRecordAdded</name>
        <dataType>Number</dataType>
        <expression>IF({!$Record.Updated_Member_Count__c}=0, {!$Record.Inserted_Member_Count__c}, {!$Record.Updated_Member_Count__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>DoNotContactText</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.DoNotCall_Count__c} == 1, 
    TEXT({!$Record.DoNotCall_Count__c}) + &apos; contact was not added to the &apos; + {!$Record.Name} + &apos; list due to a Do Not Contact Alert.&apos;,
    IF({!$Record.DoNotCall_Count__c} &gt; 1, 
        TEXT({!$Record.DoNotCall_Count__c}) + &apos; contacts were not added to the &apos; + {!$Record.Name} + &apos; list due to a Do Not Contact Alert.&apos;,
        &apos;&apos;
    ) 
)</expression>
    </formulas>
    <formulas>
        <name>InsertCountText</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Inserted_Member_Count__c} == 1 , 
          TEXT({!$Record.Inserted_Member_Count__c}) + &apos;  new contact has been added to the &apos; + {!$Record.Name} +&apos; list.&apos;,
          TEXT({!$Record.Inserted_Member_Count__c}) + &apos;  new contacts have been added to the &apos; + {!$Record.Name} +&apos; list.&apos;  
     )</expression>
    </formulas>
    <formulas>
        <name>NoContactsLoadedEmailSubject</name>
        <dataType>String</dataType>
        <expression>&apos;No Contacts Loaded to list: &apos;+{!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>PartialEmailSubject</name>
        <dataType>String</dataType>
        <expression>&apos;Partial Contacts Loaded to list: &apos;+{!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Remainingtext</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Updated_Member_Count__c}&gt;0, &apos;The remaining contacts are already on the &apos;+ {!$Record.Name} +&apos; list.&apos; , &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>RemainingTextForDNC</name>
        <dataType>String</dataType>
        <expression>&apos;The remaining contacts are already on the &apos;+ {!$Record.Name} +&apos; list.&apos;</expression>
    </formulas>
    <formulas>
        <name>Subject</name>
        <dataType>String</dataType>
        <expression>&apos;Finished adding members to list &apos;+{!$Record.Name}</expression>
    </formulas>
