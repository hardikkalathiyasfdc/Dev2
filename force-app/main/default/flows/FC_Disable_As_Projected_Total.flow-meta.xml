    <formulas>
        <description>This formula capture the relevant error message from exception occurred in the flow execution.</description>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <expression>MID(
    {!$Flow.FaultMessage},
    FIND(
        &quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;,
        {!$Flow.FaultMessage}
    ) +
    LEN(
        &quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;
    ),
    FIND(
        &quot;. You can look up ExceptionCode&quot;,
        {!$Flow.FaultMessage}
    ) -
    FIND(
        &quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;,
        {!$Flow.FaultMessage}
    ) -
    LEN(
        &quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;
    )
)</expression>
    </formulas>
