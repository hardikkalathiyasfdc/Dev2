<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Closes the action modal after a hard delete and navigates to the parent Initiative record, without rendering any screen.</description>
        <name>Auto_Close_Delete</name>
        <label>Close and Navigate to Initiative</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>c:flowFinishNavigation</actionName>
        <actionType>component</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>Get_Strategic_Location.Initiative__c</elementReference>
            </value>
        </inputParameters>
        <nameSegment>c:flowFinishNavigation</nameSegment>
    </actionCalls>
    <actionCalls>
        <description>Refreshes the record page and closes the action modal in the background, without rendering any screen.</description>
        <name>Auto_Close_Update</name>
        <label>Close and Refresh Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>c:flowFinishNavigation</actionName>
        <actionType>component</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>c:flowFinishNavigation</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets review status to Pending Removal while keeping Deleted false until committee action.</description>
        <name>Set_Pending_Removal</name>
        <label>Set Pending Removal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Strategic_Location.Review_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending Removal</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Strategic_Location.Deleted__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Strategic_Location</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Routes to hard delete for non-approved Initiatives or pending-removal request for approved Initiatives.</description>
        <name>Is_Initiative_Approved</name>
        <label>Is Initiative Approved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Delete_Strategic_Location</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Strategic_Location.Initiative__r.Approved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Pending_Removal</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Blocks remove processing when the Strategic Location is already deleted or already pending review.</description>
        <name>Is_Request_Eligible</name>
        <label>Is Request Eligible</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Initiative_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Eligible</defaultConnectorLabel>
        <rules>
            <name>Already_Deleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Strategic_Location.Deleted__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invalid_Request_Screen</targetReference>
            </connector>
            <label>Already Deleted</label>
        </rules>
        <rules>
            <name>Pending_Addition</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Strategic_Location.Review_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Addition</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invalid_Request_Screen</targetReference>
            </connector>
            <label>Pending Addition</label>
        </rules>
        <rules>
            <name>Pending_Removal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Strategic_Location.Review_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Removal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invalid_Request_Screen</targetReference>
            </connector>
            <label>Pending Removal</label>
        </rules>
    </decisions>
    <description>IM-Strategic Location review process: remove Strategic Locations by delete (pre-approval) or pending removal request (post-approval). (BRME-6823)</description>
    <environments>Default</environments>
    <interviewLabel>Remove Strategic Location {!$Flow.CurrentDateTime}</interviewLabel>
    <label>IM - Remove Strategic Location Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordDeletes>
        <description>Permanently deletes the Strategic Location when Initiative is not approved.</description>
        <name>Delete_Strategic_Location</name>
        <label>Delete Strategic Location</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Auto_Close_Delete</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>IM_Strategic_Locations__c</object>
    </recordDeletes>
    <recordLookups>
        <description>Loads the current Strategic Location record from page context.</description>
        <name>Get_Strategic_Location</name>
        <label>Get Strategic Location</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Request_Eligible</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>IM_Strategic_Locations__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Persists pending removal values to submit the Strategic Location for committee review.</description>
        <name>Update_Strategic_Location</name>
        <label>Update Strategic Location</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Auto_Close_Update</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <inputReference>Get_Strategic_Location</inputReference>
    </recordUpdates>
    <screens>
        <description>Displays fault details when delete or update operations fail.</description>
        <name>Error_Screen</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ErrorText</name>
            <fieldText>&lt;p&gt;Unable to process the removal request. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Informs the user the remove action is not eligible for the current record state.</description>
        <name>Invalid_Request_Screen</name>
        <label>Request Not Allowed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>InvalidRequestText</name>
            <fieldText>&lt;p&gt;This Strategic Location cannot be removed because it is already deleted or already has a pending review request.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
