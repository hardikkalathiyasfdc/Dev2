    <decisions>
        <name>checkNumberofPayments</name>
        <label>checkNumberofPayments</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>LessThanOrEqualsTo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>eachPayament</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>storeInstallments</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignScheduledate</targetReference>
            </connector>
            <label>LessThanOrEqualsTo</label>
        </rules>
        <rules>
            <name>GeaterThanPayments</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>eachPayament</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>storeInstallments</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>insertPayments</targetReference>
            </connector>
            <label>GeaterThanPayments</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>dividepledge</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Pledge_Amount__c}/{!storeInstallments}</expression>
        <scale>3</scale>
    </formulas>
    <formulas>
        <name>installmentAmount</name>
        <dataType>Number</dataType>
        <expression>IF({!testcase}=0, {!dividepledge}, IF({!eachPayament}!={!storeInstallments}, VALUE(TRIM(LEFT(TEXT({!dividepledge}),FIND(&quot;.&quot;, TEXT({!dividepledge}))))), ({!$Record.Pledge_Amount__c}-(VALUE(TRIM(LEFT(TEXT({!dividepledge}),FIND(&quot;.&quot;, TEXT({!dividepledge}))))))*({!storeInstallments}-1))))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>paymentName</name>
        <dataType>String</dataType>
        <expression>&quot; - &quot; &amp;TEXT({!eachPayament}) &amp; &quot; of &quot; &amp;TEXT({!storeInstallments})&amp;&quot; &quot;&amp;&quot;payments&quot;</expression>
    </formulas>
    <formulas>
        <name>scheduleDates</name>
        <dataType>Date</dataType>
        <expression>IF({!eachPayament}==1, {!$Record.First_Payment_Date__c},ADDMONTHS({!tempDate},VALUE(TEXT({!$Record.Frequency_Months__c}))) )</expression>
    </formulas>
    <formulas>
        <name>testcase</name>
        <dataType>Number</dataType>
        <expression>MOD({!$Record.Pledge_Amount__c},{!storeInstallments})</expression>
        <scale>0</scale>
    </formulas>
