<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Budget_Term_Months_More_Than_120</fullName>
    <active>true</active>
    <description>IM-116:</description>
    <errorConditionFormula>!$Setup.Bypass_Automation_Setting__c.IM_Budget_Validation__c &amp;&amp;
