<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Budget_Amount__c</fullName>
    <description>IM-197:Initiative Approved amount is considered as Total BP Amount and Total Partner Fund Amount if type is offset.</description>
    <formula>Total_BP_Amount__c + IF(ISPICKVAL(Initiative__r.Partner_Funding_Type__c, &apos;Offset&apos;) ,  Total_Partner_Fund_Allocated_Amount__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Budget Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
