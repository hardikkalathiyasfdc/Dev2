    <fullName>Reporting_Parent_Required</fullName>
    <active>true</active>
    <description>IM-214: Reporting Parent is required when Rollup in Reporting is selected.</description>
    <errorConditionFormula>!$Setup.Bypass_Automation_Setting__c.Foundation_Code_Validation__c &amp;&amp;
