<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Initiative_Total_Paid_Amount_USD__c</fullName>
    <description>IM-126:This field will be calculated by sf2sql. It should be read only on UI. This amount is in USD. This is applicable for NBI as well</description>
    <formula>IF( RecordType.DeveloperName  = &apos;Budgeted_Initiative&apos;,  
         Current_Budget__r.Total_Paid_Amount_USD__c , 
         IF(RecordType.DeveloperName  = &apos;Non_Budgeted_Initiative&apos;,
                 Misc_Total_Paid_Amount_USD__c ,
               0
         )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Initiative Total Paid Amount (USD)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
