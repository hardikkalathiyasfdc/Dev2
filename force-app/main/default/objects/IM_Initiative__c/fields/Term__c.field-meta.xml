<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Term__c</fullName>
    <description>IM-38 : Created this field as a part of Create Initiative Object.

Represents the initiative duration in months. ( Based on Start Date and End Date )</description>
    <externalId>false</externalId>
    <formula>IF(OR(ISBLANK(Start_Date__c), ISBLANK(End_Date__c)), 
     null,
     CEILING((End_Date__c - Start_Date__c) / 30.5)
)</formula>
    <label>Term (months)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
