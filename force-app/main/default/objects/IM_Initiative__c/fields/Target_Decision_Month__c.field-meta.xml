<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Target_Decision_Month__c</fullName>
    <description>IM-38 : Created this field as a part of Create Initiative Object.

Represents the Month and Year based on the Target Decision Date of the initiative.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Target_Decision_Date__c), 
     &quot;&quot;,
     TEXT(YEAR(Target_Decision_Date__c)) + &quot;-&quot; + RIGHT(&quot;0&quot; + TEXT(MONTH(Target_Decision_Date__c)), 2)
)</formula>
    <label>Target Decision Month</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
