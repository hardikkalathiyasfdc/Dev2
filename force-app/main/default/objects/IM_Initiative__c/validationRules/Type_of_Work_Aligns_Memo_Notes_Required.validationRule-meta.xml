    <errorDisplayField>Type_of_Work_Aligns_Memo_Notes__c</errorDisplayField>
    <errorMessage>Type of Work Aligns Memo Notes is required when Type of Work Aligns Memo is &quot;No&quot;.</errorMessage>
</ValidationRule>
