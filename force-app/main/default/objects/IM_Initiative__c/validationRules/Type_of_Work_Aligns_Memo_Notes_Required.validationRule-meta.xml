    <active>true</active>
    <description>BRME-7039: Type of Work Aligns Memo Notes is required when Type of Work Aligns Memo = No.</description>
    <errorConditionFormula>!$Setup.Bypass_Automation_Setting__c.IM_Initiative_Validation__c &amp;&amp;
