<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Term_Months_Cannot_Be_More_Than_120</fullName>
    <active>true</active>
    <description>Initiative Term months cannot be more than 120</description>
    <errorConditionFormula>!$Setup.Bypass_Automation_Setting__c.IM_Initiative_Validation__c &amp;&amp;
Term__c &gt; 120</errorConditionFormula>
    <errorDisplayField>End_Date__c</errorDisplayField>
    <errorMessage>Initiative Term (months) cannot be more than 120.</errorMessage>
</ValidationRule>
