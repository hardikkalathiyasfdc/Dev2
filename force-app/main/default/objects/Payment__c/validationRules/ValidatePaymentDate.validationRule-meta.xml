<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ValidatePaymentDate</fullName>
    <active>true</active>
    <description>If the Payment date is blank for a payment record with the status as Paid.</description>
    <errorConditionFormula>AND(
!$Setup.Bypass_Automation_Setting__c.Payment_Validation__c,
ISPICKVAL( Status__c ,&apos;Paid&apos;),
ISBLANK(  Payment_Date__c )
)</errorConditionFormula>
    <errorDisplayField>Payment_Date__c</errorDisplayField>
    <errorMessage>Please Enter the payment date for the payment.</errorMessage>
</ValidationRule>
