<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_or_Organization_is_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISBLANK( Contact__c ),
ISBLANK(  Organization__c  ) 

)</errorConditionFormula>
    <errorMessage>Please select either Contact or Organization for the note.</errorMessage>
</ValidationRule>
