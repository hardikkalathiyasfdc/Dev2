<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Review_Status__c</fullName>
    <description>(BRME-6823) Tracks the current review status of a Strategic Location addition or removal request submitted for an approved Initiative. A blank value indicates that no Committee review is pending.</description>
    <label>Review Status</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending Addition</fullName>
                <default>false</default>
                <label>Pending Addition</label>
            </value>
            <value>
                <fullName>Pending Removal</fullName>
                <default>false</default>
                <label>Pending Removal</label>
            </value>
            <value>
                <fullName>Deleted</fullName>
                <default>false</default>
                <label>Deleted</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
