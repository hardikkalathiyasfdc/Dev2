<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Parent_Record__c</fullName>
    <description>BRME-6771: Formula field to navigate user to the parent record that references the history</description>
    <externalId>false</externalId>
    <formula>IF(
  ISBLANK(Record_ID__c),
  &quot;&quot;,
  HYPERLINK(&quot;/&quot; &amp; Record_ID__c, &quot;View Record&quot;, &quot;_self&quot;)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Parent Record</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
