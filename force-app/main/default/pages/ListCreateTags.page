<apex:page standardController="Campaign" tabStyle="Campaign" >
    <apex:sectionHeader title="{!Campaign.Name}" subtitle="Add tag to members"/>
 <apex:pageBlock >
  <apex:includeLightning />
    <div id="lightning" style="height:600px;"/>
    <script>
      var recordId = '{!Campaign.id}';
      $Lightning.use("c:ListCreateTagsApp", function() {
      	var attributes = {
        	recordId: recordId,
            fromRelatedList : true
        };
          $Lightning.createComponent(
                    "c:ListCreateTags",
                    attributes,
                    "lightning",
                    function(cmp) {
                        console.log("Component is created!");
                    });
        });
    </script>
 
 </apex:pageBlock>



</apex:page>