<apex:page controller="BoardMemberInteractionsCtrl" contentType="text/html">
    <head>
        <style>
            body {
            font-family: Times;	
            }
            .section-header{
            font-size : 16px;
            color:#2f5496;
            font-weight: bold;
            margin-top: 10px; 
            }
            
            .section-text{
            font-size : 16px;
            margin-top: 10px; 
            }
            
        </style>
    </head>
    
    
    <body>
        <!-- generated by content starts here -->
        
        <div style="font-size: 21px;font-weight: bold;">
            {!title}
        </div>
        
        <apex:outputPanel rendered="{!!hasInteractions}" styleClass="section-text" layout="block">There were no interactions with Board Members reported this month. </apex:outputPanel> 
        <!-- page title ends here -->
        <div class="content" id="content">
            <!-- interaction table starts here -->
            <apex:variable var="trcolor" value="#D9E1F2"/>
            <apex:outputPanel rendered="{!hasInteractions}"  styleClass="section-text" layout="block">     
                <table 
                       border="1" 
                       width="100%" 
                       cellspacing="0" 
                       cellpadding="5"
                       style="border-collapse: collapse; text-align: left; font-family: Arial, sans-serif;">
                    <thead>
                        <tr>
                            <th style="border: 1px solid;font-size: 20px;width: 20%;">Board Member</th>
                            <th style="border: 1px solid;font-size: 20px;width: 15%;">Date</th>
                            <th style="border: 1px solid;font-size: 20px;width: 65%;">Description</th> 
                        </tr>
                    </thead>
                    <tbody id="main">
                        
                        <apex:repeat value="{!interactions}" var="row">
                            <apex:outputPanel layout="none"
                                              >
                             
                                <tr style="background-color: {!trcolor}"> 
                                    <apex:outputPanel rendered="{!row.rowCount >0}" styleClass="section-text" layout="none">   
                                        <td rowspan="{!row.rowCount}">{!row.boardMember}</td> 
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!row.rowCount ==0}" styleClass="section-text" layout="none">   
                                        <td >{!row.boardMember}</td> 
                                    </apex:outputPanel>
                                    <apex:variable var="isFirstRow"  value="true" />  
                                    <apex:repeat value="{!row.info}" var="item">  
                                        <apex:outputPanel rendered="{!isFirstRow='true'}" styleClass="section-text" layout="none">   
                                            <td>{!item.interactionDate}</td>
                                            <td ><apex:outputText value="{!item.description}" escape="false" /></td>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!isFirstRow='false'}" styleClass="section-text" layout="none"> 
                                            <tr style="background-color: {!trcolor}"> 
                                                <td>{!item.interactionDate}</td>
                                                <td ><apex:outputText value="{!item.description}" escape="false" /></td>
                                            </tr>
                                        </apex:outputPanel>
                                        
                                        <apex:variable var="isFirstRow" value="false" />
                                    </apex:repeat>
                                </tr>
                                <apex:variable var="trcolor" value="{!IF(trcolor == '#D9E1F2', '#E2EFDA', '#D9E1F2')}"/>
                            </apex:outputPanel>
                            
                        </apex:repeat>
                    </tbody>
                </table>
                
            </apex:outputPanel>
        </div>
        <apex:outputPanel rendered="{!hasInteractions}" styleClass="section-text" layout="block">    
            <div class="footer" name="footer" style="padding: 5px; font-size : 14px;">                
                <apex:outputPanel layout="block" rendered="{!!isAutoGenerated}">
                    Created On {!currentDateLocal} (via BRM)
                </apex:outputPanel>
                
                <apex:outputPanel layout="block" rendered="{!isAutoGenerated}">
                    Created On {!currentDateLocal} (via BRM)
                </apex:outputPanel>
                
            </div>
        </apex:outputPanel>
        <!-- interaction table ends here -->
    </body>    
</apex:page>