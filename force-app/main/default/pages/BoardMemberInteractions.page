<apex:page controller="BoardMemberInteractionsCtrl" renderAs="pdf"  showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false">
    <head>
        <style>
            @page {
                size: A4;
                @bottom-left {
                    content: element(footer);
                }
                @bottom-right {
                    content: "" counter(page) " of " counter(pages);
                }
            }
            div.footer {
                display: block;
                padding: 10px;
                position: running(footer);
            }
            body {
                font-family: Times;	
            }
            .section-header {
                font-size : 16px;
                color:#2f5496;
                font-weight: bold;
                margin-top: 10px; 
            }
            .section-text {
                font-size : 16px;
                margin-top: 10px; 
            }
        </style>
    </head>
    <body>
        <!-- generated by content starts here -->
        <apex:outputPanel rendered="{!hasInteractions}" styleClass="section-text" layout="block">    
            <div class="footer" name="footer" style="padding: 5px; font-size : 14px;">                
                <apex:outputPanel layout="block" rendered="{!!isAutoGenerated}">
                    Created By {!$User.FirstName} {!$User.LastName} (via BRM) <br/>
                    On {!currentDateLocal}
                </apex:outputPanel>
                <apex:outputPanel layout="block" rendered="{!isAutoGenerated}">
                    Created On {!currentDateLocal} (via BRM)
                </apex:outputPanel>
            </div>
        </apex:outputPanel>
        <div style="font-size: 21px;font-weight: bold;">
            {!title}
        </div>
        <apex:outputPanel rendered="{!!hasInteractions}" styleClass="section-text" layout="block">
            There were no interactions with Board Members reported this month. 
        </apex:outputPanel> 
        <!-- page title ends here -->
        <div class="content" id="content">
            <!-- interaction table starts here -->
            <apex:variable var="trcolor" value="#D9E1F2"/>
            <apex:outputPanel rendered="{!hasInteractions}"  styleClass="section-text" layout="block">     
                <table border="0" width="100%" cellspacing="0" cellpadding="5"
                    style="-fs-table-paginate: paginate; border: 1px solid; border-collapse: collapse; text-align: left;">
                    <thead style="display:table-header-group;">
                        <tr>
                            <th style="border: 1px solid;font-size: 20px;width: 30%;">Board Member</th>
                            <th style="border: 1px solid;font-size: 20px;width: 30%;">Date</th>
                            <th style="border: 1px solid;font-size: 20px;width: 70%;">Description</th> 
                        </tr>
                    </thead>
                    <tbody id="main">
                        <apex:repeat value="{!interactions}" var="row">
                            <apex:outputPanel layout="none">
                                <apex:variable var="isFirstRow" value="true"/>
                                <apex:repeat value="{!row.info}" var="item">
                                    <tr style="background-color: {!trcolor}"> 
                                        <apex:outputPanel rendered="{!isFirstRow='true'}" styleClass="section-text" layout="none">   
                                            <td style="border-top: 1px solid; font-size: 18px; vertical-align:top;padding-top: 10px;">
                                                {!if(isFirstRow = 'true', row.boardMember, '')}
                                            </td>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!isFirstRow='false'}" styleClass="section-text" layout="none">  
                                           <td style="border: 0px solid; font-size: 18px; vertical-align:top;padding-top: 10px;">
                                                {!if(isFirstRow = 'true', row.boardMember, '')}
                                            </td>
                                        </apex:outputPanel>
                                        <td style="border: 1px solid; font-size: 18px; min-height: 25px;">
                                            {!item.interactionDate}
                                        </td>
                                        <td style="border: 1px solid; font-size: 18px;">
                                            <apex:outputText value="{!item.description}" escape="false"/>
                                        </td>
                                    </tr>
                                    <apex:variable var="isFirstRow" value="false" />
                                </apex:repeat>
                                <apex:variable var="trcolor" value="{!IF(trcolor == '#D9E1F2', '#E2EFDA', '#D9E1F2')}"/>
                            </apex:outputPanel>
                        </apex:repeat>
                    </tbody>
                </table>
            </apex:outputPanel>
        </div> 
        <!-- interaction table ends here -->
    </body>
</apex:page>