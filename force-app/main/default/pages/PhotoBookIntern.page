<!--
* Author: 
* Date Modified: 05/21/2024
* Description : Visualforce page for generating an HR photo book PDF featuring intern profiles with detailed personal and professional information.
* Modified By : Hardik - BRME-5326 : changed code to display Country, State, City for Photobookintern
-->
<apex:page controller="PhotoBookController" renderAs="pdf" readOnly="true" showHeader="false" sidebar="false" title="HR Photo Book" applyBodyTag="false">
	<head>
		<style type="text/css" media="print">
			@page {
				@top-center {
					content: element(header);
				}
				@bottom-left {
					content: element(footer);
				}
			}
			div.header {
				padding: 10px;
				position: running(header);
			}
			div.footer {
				display: block;
				padding: 5px;
				position: running(footer);
			}
			.pagenumber:before {
				content: counter(page);
			}
			.pagecount:before {
				content: counter(pages);
			}
            table { page-break-inside:auto }
			.profilePicture{
                width:100px;
                height:100px;
            	border-radius:70%;
            	display:inline-block;
            }
            .containerPerson {
                overflow:hidden;
                margin:2px 10px 10px 2px;
                height:4in;
                box-shadow: 10px 10px 5px lightgrey;
            }
            .containerPersonTop {
                height:110px;
            	word-wrap:break-word;
            }
            .containerField {
            	font-family: Arial, Helvetica, sans-serif;
                padding-bottom:10px;
                font-size:85%;
            	margin-left:-30px;
            	overflow-wrap: normal;
            }
            .name {
            	font-family: Arial, Helvetica, sans-serif;
                font-size:100%;
            	font-weight: bold;
            	color:#5D008D;
            	word-wrap: break-word;
                hyphens: auto;
            }
            .leftContainer {
            	overflow-wrap: normal;
            }
            .fieldLabel {
				color:#5D008D;
            	font-weight: bolder;
            }
            .department {
            	width: 1.9in;
            	padding: 2px;
            	font-family: Arial, Helvetica, sans-serif;
                font-size:70%;
                color:#5D008D;
                text-transform: uppercase;
                word-wrap: break-all !important;
                hyphens: auto;
            }
            .phone {
            	width: 1.9in;
            	padding: 2px;
            	font-family: Arial, Helvetica, sans-serif;
                font-size:70%;
                color:black;
            }
            .personName {
            	width: 1.6in;
            	padding: 2px;
            	font-family: Arial, Helvetica, sans-serif;
            	font-size:90%;
            	color:#5D008D;
            	font-weight: bold;
				overflow-wrap: break-word;
                word-wrap: break-word;
                hyphens: auto;
            }
            .email {
           		width: 1.9in;
            	padding: 2px;
            	font-family: Arial, Helvetica, sans-serif;
                font-size:80%;
            	color:blue;
            }
            .column {
                width:2.75in;
            }
            .table {
                table-layout: fixed;
                width: 7in;
            	padding:5px;
            }
            .bold {
            	font-weight: bold;
            	font-family: sans-serif; 
            }
		</style>
	</head>
    <div style="position:relative;width:7in;height:9in;background-color:#5D008D;color:white;padding-left:0.5in;page-break-after:always">
        <div style="font-size: 400%;">
            Bloomberg
        </div>
        <div style="font-size: 400%;padding-bottom:50px;margin-top:-0.25in">
            Philanthropies
        </div>
        <div style="font-size: 300%;border-top:5px solid white;padding-top:100px;width:7in">
            {!internListName}
        </div>
    </div>
    
    <div class="footer">
	</div>
    
	<div class="content">
		<apex:repeat value="{!internContacts}" var="con">
			<div style="border:2px solid #C0C0C0;margin:10px;page-break-inside: avoid;" >
				<table class="table">
					<tr>
						<td width="30%">
							<div>
								<apex:outputPanel layout="block" >
                                    <span class="personName">{!con.c.First_Preferred_First_Name__c} {!con.c.LastName} {!con.c.Suffix}</span>
                                    <div class="department">{!con.c.Department__c}</div>
                                    <span class="email">{!con.c.Email}</span><br/>
                                    <span class="phone">{!con.c.Phone}</span>
                                    <br/>
                                    <img src="{!con.imageUrl}" class="profilePicture"/>
								</apex:outputPanel>
							</div> 
						</td>
                        
						<td width="60%">
							<div>
								<apex:outputPanel rendered="{!con.c.School_and_Major__c!=null}" layout="block" styleClass="containerField"><span class="name">What  school do you attend and what is your major?</span><br/> {!con.c.School_and_Major__c}</apex:outputPanel>
								<apex:outputPanel rendered="{!OR(con.c.OtherCity!=null,con.c.OtherState!=null,con.c.OtherCountry!=null)}" layout="block" styleClass="containerField"><span class="name">Where are you from?</span><br/> 
                                    <apex:outputPanel rendered="{!con.c.OtherCity!=null}">{!con.c.OtherCity}</apex:outputPanel> 
                                    <apex:outputPanel rendered="{!AND(con.c.OtherCity!=null,con.c.OtherState!=null)}">,&nbsp;  </apex:outputPanel>
                                    <apex:outputPanel rendered="{!con.c.OtherState!=null}">{!con.c.OtherState}</apex:outputPanel> 
                                    <apex:outputPanel rendered="{!OR(con.c.OtherState==null,con.c.OtherCity==null)}">
                                        <apex:outputPanel rendered="{!AND(OR(con.c.OtherState!=null,con.c.OtherCity!=null),con.c.OtherCountry!=null)}">,&nbsp; </apex:outputPanel>
                                        <apex:outputPanel rendered="{!con.c.OtherCountry!=null}">{!con.c.OtherCountry}</apex:outputPanel></apex:outputPanel>
                                </apex:outputPanel> 
								<apex:outputPanel rendered="{!con.c.Skills_developed_during_Internship__c !=null}" layout="block" styleClass="containerField"><span class="name" >What skills do you hope to gain or develop from this internship?</span><br/>{!con.c.Skills_developed_during_Internship__c}</apex:outputPanel>
								<apex:outputPanel rendered="{!con.c.Favorite_Volunteer_Job_Experience__c!=null}" layout="block" styleClass="containerField"><span class="name"> What has been your favorite volunteer or job experience?</span><br/>{!con.c.Favorite_Volunteer_Job_Experience__c}</apex:outputPanel>
								<apex:outputPanel rendered="{!con.c.What_is_your_dream_job__c!=null}" layout="block" styleClass="containerField"><span class="name">What is your dream job?</span><br/>{!con.c.What_is_your_dream_job__c}</apex:outputPanel>
							</div> 
						</td>
					</tr>
				</table>
			</div>
		</apex:repeat>
	</div>
</apex:page>