                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;New to BIM?&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Below are some ways to learn more about the tool, get up to speed on how to use it, and where to find answers to your questions.&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Help yourself to robust resources!&lt;/strong&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://bloomberg.csod.com/samldefault.aspx?ouid=6&amp;amp;returnUrl=%252fDeepLink%252fProcessRedirect.aspx%253fmodule%253dlaunchtraining%2526lo%253dbd1dd0b1-16dd-44de-b61d-89790b309049&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px;&quot;&gt;BIM Training&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://bloombergdotorg.sharepoint.com/Shared%20Documents/Forms/AllItems.aspx?id=%2FShared%20Documents%2FCityView%20%26%20BRM%2FInitiative%20Management%20User%20Guide%2Epdf&amp;amp;parent=%2FShared%20Documents%2FCityView%20%26%20BRM&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px;&quot;&gt;User Manual&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://bloombergdotorg.sharepoint.com/:b:/r/Shared%20Documents/CityView%20%26%20BRM/IM%20Glossary.pdf?csf=1&amp;amp;web=1&amp;amp;e=tWSLnk&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px;&quot;&gt;Glossary&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://chatgpt.com/g/g-69556705ff0881918aef7a70e56973d5-initiaitive-management-support-bot&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px;&quot;&gt;GPT Bot&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Reach out to Sara Ginsberg or Kelly Mehlenbacher directly&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; – we are here to support you on this new journey in Initiative Management.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;</value>
