                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style=&quot;color: rgb(28, 28, 28); font-size: 16px;&quot;&gt;Welcome to BIM!&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0);&quot;&gt;BIM (Bloomberg Initiative Management) is Bloomberg Philanthropies’ central platform for managing initiatives. It standardizes and streamlines initiative budgeting, tracking, approvals, and reporting across programs. BIM integrates with existing systems to automate data flows, provide real-time dashboards, and serve as a single source of truth for initiative data—improving efficiency, transparency, and collaboration. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://bloombergdotorg.sharepoint.com/:v:/r/Shared%20Documents/CityView%20%26%20BRM/Bloomberg%20Initiative%20Management.mp4?csf=1&amp;amp;web=1&amp;amp;e=QfNDvj&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: rgb(1, 118, 211); font-size: 14px;&quot;&gt;Watch this short introduction&lt;/a&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; to understand why BIM was created and how it supports stronger initiative planning and management.&lt;/span&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
