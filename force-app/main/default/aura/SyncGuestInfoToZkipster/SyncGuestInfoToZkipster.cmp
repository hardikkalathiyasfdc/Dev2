<aura:component controller="EventMangementAuraCtrl" implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction"
    access="global">

    <aura:attribute name="recordId" type="String" />
	<lightning:spinner alternativeText="Loading" size="large" />
	<aura:handler name="init" value="{!this}" action="{!c.init}" />
    
</aura:component>