<aura:component access="global">
    <!--aura attributes-->  
    <aura:attribute name="oRecord" type="sObject" />
    <aura:attribute name="IconName" type="string"/> 
    
    <!--Register the component level event-->
    <aura:registerEvent name="oSelectedRecordEvent" type="c:selectedsObjectRecordsEvent"/>
    
    <li role="presentation" class="slds-listbox__item" onclick="{!c.selectRecord}">
        <span id="listbox-option-unique-id-01" class="slds-media slds-listbox__option slds-listbox__option_entity slds-listbox__option_has-meta" role="option">
            <span class="slds-media__figure">
                <span class="slds-icon_container" title="Description of icon when needed">
                    <lightning:icon iconName="{!v.IconName}" class="slds-icon slds-icon_small" size="small" alternativeText="icon"/>
                </span>
            </span>    
            <span class="slds-media__body">  
                <aura:if isTrue="{!v.oRecord.Preferred_First_Name__c}">
                    <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.FirstName} ({!v.oRecord.Preferred_First_Name__c}) {!v.oRecord.LastName}</span>
                    <aura:set attribute="else">
                        <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.FirstName}&nbsp;{!v.oRecord.LastName}</span>
                    </aura:set>
                </aura:if>
                <aura:if isTrue="{!v.oRecord.Title}">
                    <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.Title}</span>
                </aura:if>
                <aura:if isTrue="{!v.oRecord.Account.Name}">
                    <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.Account.Name}</span>
                </aura:if>
                <aura:if isTrue="{!v.oRecord.Email}">
                    <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.Email}</span>
                </aura:if>                
            </span>
            <!--<span class="slds-media__body">  
                <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.Name}</span>
            </span>
            <aura:if isTrue="{!$Browser.formFactor == 'DESKTOP'}">
            <span class="slds-media__body">  
                <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.Preferred_First_Name__c}</span>
            </span>
            <span class="slds-media__body">  
                <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.Title}</span>
            </span>
            </aura:if>
            <span class="slds-media__body">  
                <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.Account.Name}</span>
            </span>
            <span class="slds-media__body">  
                <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!v.oRecord.Email}</span>
            </span>-->
        </span>
    </li>
</aura:component>