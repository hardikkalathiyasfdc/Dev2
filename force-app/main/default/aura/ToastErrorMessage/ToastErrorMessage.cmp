<aura:component implements="flexipage:availableForAllPageTypes,lightning:availableForFlowScreens" access="global" >
    <aura:attribute name="errorMessage" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.showMyToast}"/>
    
    <div class="slds-text-color_destructive">Error Occured</div>
    
</aura:component>