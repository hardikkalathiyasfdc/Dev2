<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId" access="global" controller="CampaignMembersAuraController">
	<aura:attribute name="campaignMembers" type="List"/>
    <aura:attribute name="allCampaignMembers" type="List"/>
	<aura:attribute name="numberOfMembers" type="Integer"/>
	<aura:attribute name="showActiveLists" type="Boolean" />
    <aura:attribute name="showAll" type="Boolean" default="false" />
    <aura:attribute name="showButton" type="Boolean" default="false" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <article class="slds-card" >
        
            <div class="slds-card__header slds-grid">
                <header class="slds-media slds-media_center slds-has-flexi-truncate">
                    <div class="slds-media__figure">
                        <lightning:icon iconName="standard:campaign_members" alternativeText="List Members" />
                    </div>
                    <div class="slds-media__body">
                        <h2 class="slds-card__header-title">
                            <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="List Members">
                                <span>List Members - 
                                    <aura:if isTrue="{!v.showActiveLists}">
                                        Active
                                        <aura:set attribute="else">
                                            Historic
                                        </aura:set> 
                                    </aura:if>
                                    ({!v.numberOfMembers})</span>
                            </a>
                        </h2>
                    </div>
                    <aura:if isTrue="{!v.showButton == true}">
                        <div class="slds-float_right">
                            <lightning:button label="{!v.showAll?'Show Less':'Show All'}" onclick="{!c.showContent}"></lightning:button>
                        </div>
                    </aura:if>
                </header>
            </div>
            <aura:if isTrue="{!v.showAll == true}">
                <div>
                <div class="slds-card__body slds-scrollable--y">
                    <ul>
                    <aura:iteration items="{!v.campaignMembers}" var="cm">
                        <li><lightning:formattedUrl value="{!'/'+cm.Id}" label="{!cm.Campaign.Name}" class="cmLink"/></li>
                    </aura:iteration>
                    </ul>
                </div>
            </div>
                <aura:set attribute="else">
                    <div >
                        <div class="slds-card__body slds-scrollable--y">
                            <ul>
                            <aura:iteration items="{!v.campaignMembers}" var="cm">
                                <li><lightning:formattedUrl value="{!'/'+cm.Id}" label="{!cm.Campaign.Name}" class="cmLink"/></li>
                            </aura:iteration>
                            </ul>
                        </div>
                    </div>
                </aura:set>
            </aura:if>
            
    </article>
</aura:component>