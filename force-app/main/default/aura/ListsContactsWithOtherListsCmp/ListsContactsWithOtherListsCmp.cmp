<aura:component
  implements="lightning:isUrlAddressable"
  controller="ListsContactsWithOtherListsCmpController"
  access="global"
>
  <aura:attribute name="contactLists" type="Map" default="{}" />
  <aura:attribute name="rowOffset" type="Integer" default="0" />
  <aura:attribute name="curPage" type="Integer" default="0" />
  <aura:attribute name="search" type="String" default="" />
  <aura:attribute name="isLoading" type="Boolean" default="true" />
  <aura:attribute name="showNext" type="Boolean" default="false" />
  <aura:attribute name="showPrev" type="Boolean" default="false" />
  <aura:attribute name="contactOptions" type="List" default="[]" />
  <aura:attribute name="contactFields" type="List" default="[]" />
  <aura:attribute name="listOptions" type="List" default="[]" />
  <aura:attribute name="listFields" type="List" default="[]" />

  <ltng:require scripts="{!$Resource.cmputil}" afterScriptsLoaded="{!c.init}" />
  <lightning:card class="myCard">
    <aura:if isTrue="{!v.isLoading}">
      <div style="height: 50px">
        <lightning:spinner alternativeText="Loading" size="large" />
      </div>
    </aura:if>
    <aura:set attribute="title">
      <aura:if
        isTrue="{!and(not(v.isLoading), not(empty(v.contactLists.name)))}"
      >
        <lightning:icon iconName="standard:campaign" size="small" />
        &nbsp; {!v.contactLists.name}
      </aura:if>
    </aura:set>
    <div class="slds-grid slds-grid_vertical">
      <div class="slds-col">
        <div class="slds-grid slds-gutters">
          <div class="slds-col slds-size_1-of-3">
            <div onkeyup="{! c.handleKeyUp }">
              <lightning:input
                aura:id="inputListId"
                name="listId"
                label="Type in List Id and press enter."
                value="{!v.search}"
                type="search"
              />
            </div>
          </div>
        </div>
      </div>
      <div class="slds-col" style="margin-top: 1%">
        <div class="slds-grid slds-gutters">
          <div class="slds-col slds-size_1-of-2">
            <lightning:dualListbox
              name="multipleOptions"
              label="Select Contact Fields"
              sourceLabel="Available"
              selectedLabel="Selected"
              options="{!v.contactOptions}"
              value="{!v.contactFields}"
              onchange="{! c.loadData }"
            />
          </div>
          <div class="slds-col slds-size_1-of-2">
            <lightning:dualListbox
              name="multipleOptions"
              label="Select Campaign Fields"
              sourceLabel="Available"
              selectedLabel="Selected"
              options="{!v.listOptions}"
              value="{!v.listFields}"
              onchange="{! c.loadData }"
            />
          </div>
        </div>
      </div>

      <aura:if isTrue="{!not(empty(v.contactLists.columns))}">
        <div class="slds-col" style="margin-top: 2%">
          <lightning:button
            variant="brand"
            label="Export"
            title="Export"
            class="exportBtn"
            onclick="{! c.export }"
          />
        </div>
        <div class="slds-col" style="margin-top: 1%">
          <lightning:datatable
            keyField="id"
            data="{! v.contactLists.data }"
            columns="{! v.contactLists.columns }"
            hideCheckboxColumn="true"
            showRowNumberColumn="true"
            rowNumberOffset="{!v.rowOffset}"
          /></div
      ></aura:if>
    </div>
    <aura:set attribute="footer">
      <aura:if isTrue="{!v.showPrev}">
        <lightning:button
          label="prev"
          iconName="utility:left"
          iconPosition="left"
          onclick="{!c.prevPage}"
        />
      </aura:if>
      <aura:if isTrue="{!v.showNext}">
        <lightning:button
          label="next"
          iconName="utility:right"
          onclick="{!c.nextPage}"
        />
      </aura:if>
    </aura:set>
  </lightning:card>
</aura:component>