<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Highlight_Non_Private_All_Internal</fullName>
        <accessLevel>Edit</accessLevel>
        <description>BRME-7020: Non-private highlights (Private__c = false) are readable/writable by all internal users.</description>
        <label>Highlights: Non-Private Read/Write All Internal</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
        <criteriaItems>
            <field>Private__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Highlight_Private_Review_Group</fullName>
        <accessLevel>Edit</accessLevel>
        <description>BRME-7020: Private highlights (Private__c = true) are readable/writable only by members of the &apos;Highlights: Private Highlights Review&apos; public group.</description>
        <label>Highlights: Private Read/Write Review Group</label>
        <sharedTo>
            <group>Highlights_Private_Highlights_Review</group>
        </sharedTo>
        <criteriaItems>
            <field>Private__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
